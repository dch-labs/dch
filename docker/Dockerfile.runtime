FROM rust:1.98-alpine AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY xtask ./xtask
ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN cargo build --release --all-features \
    --target x86_64-unknown-linux-musl --bin dch
RUN apk add --no-cache file
RUN sh -c "! file target/x86_64-unknown-linux-musl/release/dch \
    | grep -q 'dynamically linked'"

FROM alpine:3
COPY --from=builder /build/target/x86_64-unknown-linux-musl/release/dch \
    /usr/local/bin/dch
ENTRYPOINT ["/usr/local/bin/dch"]
CMD ["--help"]
