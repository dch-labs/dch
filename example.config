# dch example configuration.
#
# dch reads ~/.dch/config.toml; a ~/.dch/config.local.toml, when
# present, is loaded instead of it — a complete replacement, not a
# field-level merge. Every field below shows its
# possible values and its default. Copy this file, delete what you
# do not need — an unconfigured dch runs against a local Ollama
# server with the default near-black theme.

[api]
# Provider family. One of:
#   ollama    — local Ollama server (default; no API key needed)
#   openai    — OpenAI-compatible Chat Completions (also vLLM etc.)
#   anthropic — Anthropic Messages API (also used by Z.AI)
#   gemini    — Google Gemini
#   deepseek  — DeepSeek
#   grok      — xAI Grok
#   azure     — Azure OpenAI (also set azure_resource)
#   moonshot  — Moonshot AI
#   zai       — Z.AI
#   bedrock   — AWS Bedrock
#   self_hosted — llama.cpp-style local server (default local port;
#                 no API key needed)
api_type = "ollama"

# Server base URL. OpenAI-compatible servers must include the /v1
# suffix (for example "http://localhost:11434/v1" for Ollama's
# OpenAI endpoint). Default: "" (the provider's own endpoint).
# base_url = "http://localhost:11434/v1"

# Model name, as the provider knows it. Default: "".
model = "qwen3.8:27b"

# API key. Optional for ollama; providers also read their own
# environment variables (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...).
# Default: unset.
# api_key = "sk-…"

# A model that takes over when the primary fails repeatedly.
# Default: unset.
# fallback_model = "qwen3.8:14b"

# Output cap per model response, in tokens. Default: 32000.
# max_tokens = 32000

# Context window used for accounting and compaction. Unset (the default)
# asks the provider: an OpenAI-compatible local server is probed at startup,
# first its /props document (the per-request share, advertised total over
# parallel slots) and then its model listing (max_model_len, or meta.n_ctx);
# then the built-in table of documented cloud models (the GLM family today)
# answers for its models; anything else falls back to 200000. An explicit
# value always wins over discovery.
# context_window = 200000

# Per-request timeout. Default: 120 seconds.
# request_timeout_secs = 120

# Azure OpenAI resource name — azure only. Default: unset.
# azure_resource = "my-resource"

# Thinking budget for reasoning-capable models. One of:
#   none, minimal, low, medium, high, xhigh, max
# Mapped onto the provider's native dial — `none` is the explicit off,
# while unset (the default) inherits the provider's own defaults
# byte-identically. An unrecognized value fails client construction
# rather than silently defaulting.
# reasoning_effort = "medium"

# Whether Anthropic-protocol requests (api_type anthropic, zai) carry
# prompt-cache breakpoints, so the stable conversation prefix is served
# from the provider's cache across a session's turns. One of:
# true (default), false — set false for an endpoint that rejects the
# extra field. OpenAI-protocol providers cache automatically and ignore
# this on the wire; the cached share shows in verbose usage either way.
# prompt_cache = true

# Additional models to switch between with --model.
#
# Each [[models]] entry is one model's own config: it states what it needs and
# inherits the rest from [api], so a second model on the same server can be a
# one-line entry while a second provider carries its own endpoint, protocol,
# and key. The TOP entry is the default run — reorder the list to change the
# default — and `--model NAME` picks any other by name, ignoring case; a name
# matching no entry fails at startup naming the configured ones rather than
# sending a request somewhere unintended. With no entries at all, [api] is the
# whole configuration, as it always was. Naming an optional setting "" drops
# what [api] would otherwise hand over — the way to clear a reasoning_effort a
# model cannot carry, or a fallback that belongs to another provider.
# [[models]]
# model = "glm-4.6"          # required; also the name --model selects
# base_url = "https://api.z.ai/api/anthropic"
# api_type = "anthropic"     # ollama | openai | anthropic | gemini | deepseek |
#                            # grok | azure | moonshot | zai | bedrock |
#                            # self_hosted
# api_key = "…"              # unset leaves the provider's own env var in charge
# fallback_model = "…"       # "" selects no fallback at all
# max_tokens = 8192
# context_window = 200000    # state each model's own; unset probes like [api]
# request_timeout_secs = 300
# azure_resource = "my-resource"
# reasoning_effort = "medium" # none | minimal | low | medium | high | xhigh | max; "" drops the dial
# prompt_cache = true

[display]
# Theme name. One of:
#   default (the shipped default) — a neutral near-black canvas
#       with peach, violet, cyan, and green accents; the terminal's
#       own background is set to this canvas
#   transparent — the terminal's own colors; nothing
#       painted, so the terminal's background (transparency
#       included) shows through; hairline rules mark the composer
#   dracula, nord, tokyo_night, gruvbox_dark, gruvbox_light,
#   solarized_dark, solarized_light, catppuccin_latte,
#   catppuccin_frappe, catppuccin_macchiato, catppuccin_mocha,
#   one_dark, monokai, github_dark, github_light, ayu_dark,
#   rose_pine, kanagawa_wave, dark_plus, autumn_night
# An unknown name warns and falls back to the default.
theme = "default"

# Where the TUI's activity strip renders while the agent runs.
# One of: composer (default) — the spacer row directly above the
# prompt box; top — a dedicated first row of the terminal.
# strip_position = "composer"

# The animation the TUI's activity strip plays. One of:
#   breathe (default) — grows from the row's center out to both
#       edges and shrinks back
#   sweep      — fills from the left edge to the right end, then
#       clears left-to-right
#   bounce     — sweeps each way in turn, ping-ponging between edges
#   travel     — glides a short segment edge to edge and back
#   snake      — circulates a short segment out one edge, in the other
#   worm       — crawls in stretch-and-shrink beats across the row
#   worm_long  — stretches across the whole row, then folds back
#   off        — draws no strip at all
#   glow       — holds a full-width bar whose color slowly breathes
# strip_style = "breathe"

# How the TUI spells the working directory in the place row above
# the prompt box. One of: full (default) — the absolute path the
# session runs in; relative — the path spelled ~/ from the user's
# home directory, falling back to full outside home.
# path_style = "full"

# Whether the TUI captures the mouse. One of: true (default) — the
# wheel scrolls the transcript and dch owns text selection;
# false — the terminal owns selection, and the wheel reaches dch
# only where the terminal translates it to arrow keys.
# mouse_capture = true

# How the TUI lays out a file edit's diff in the conversation pane:
# "inline" (default) stacks removals above insertions as full-width
# solid bands; "side-by-side" pairs each removed line with its
# replacement across a center gutter. Narrow terminals fall back to
# inline whatever the setting.
# diff_layout = "inline"

# A custom clipboard command for the TUI's selection copy. The
# selection's text is piped to the command's stdin (run through
# sh -c, so arguments and pipes work), in addition to the built-in
# transports: the OSC 52 terminal escape and the host clipboard
# tools the environment offers (tmux set-buffer, wl-copy, xclip,
# xsel, pbcopy). Set it where none of the built-ins reach — e.g. a
# remote session whose local terminal ignores OSC 52.
# copy_command = "remote-clip send"

# Console verbosity. One of: quiet — errors only; normal (default)
# — standard output; verbose — debug-level detail.
# verbosity = "normal"

# Disable ANSI color. One of: true, false (default).
# no_color = false

[runner]
# Cap on turns per run. Default: 200.
# max_turns = 200

# Wall-clock budget for one streaming model call, in seconds — prompt
# processing plus the model's entire generation, reasoning included.
# Raise it on slow local backends (CPU inference, reasoning-heavy models).
# Must be at least 120: the stream handler replaces a smaller whole-stream
# budget with its 120-second first-event window. That window is also the
# one thing this knob cannot extend — a first token slower than 120 s
# fails the attempt there regardless of this budget. Default: 300.
# turn_timeout_secs = 900

# How the agent approaches the work. One of:
#   general (default) — general assistance
#   coding     — implement features, fix bugs
#   refactor   — restructure without behavior change
#   debug      — diagnose and isolate
#   review     — read-only critique
#   docs       — documentation
#   tests      — write and improve tests
role = "general"

# How aggressively the agent may act without asking. One of:
#   auto (default) — never prompts
#   plan           — proposes but never executes
#   accept_edits   — auto-applies file edits, prompts for the rest
#   interactive    — prompts for every side effect
# permission_mode = "auto"

# Compact the conversation automatically once it crosses
# compact_threshold percent of the context window.
# One of: true (default), false.
# auto_compact = true

# Compaction trigger, a percentage of the context window.
# Range: 0–100. Default: 80.
# compact_threshold = 80

# Which compactor automatic compaction runs: "qa" (default) summarizes the
# dropped context through the session's own model in a question/answer pass,
# "structured" summarizes into fixed sections, "truncating" drops the oldest
# messages and spends no model calls, and "rolling" ages old turns into
# small bounded summaries while the session runs.
# compactor = "qa"


# Let file tools reach paths outside the working directory.
# One of: true, false (default). The --unsafe-paths flag is the
# same switch per invocation.
# unsafe_paths = false

# Line ceiling one Read (or one file inside a ReadFiles batch) may
# return; a longer file is cut with a marker naming where reading
# continues. Default: 1200 — a long documentation file fits in one
# call, so an orientation over a doc list does not spend a
# round-trip per paging continuation.
# read_max_lines = 1200

# Byte ceiling on one read's joined, line-numbered output — the real
# bound that also cuts a single minified line or a window of wide
# lines, always on the last complete line. Default: 49152 bytes, sized
# to stay under the tool-output cap below so the read's own
# continuation-naming marker is the one that fires, not the blunt cut.
# read_max_bytes = 49152

# Character ceiling on one dispatched tool result — the bound the
# conversation-level pipeline enforces over whatever the tool
# returned, so no single result spends more of the model's context
# than this. A longer result keeps its leading characters plus a
# "[truncated]" marker. 0 disables the cap, which also lifts the
# requirement that read_max_bytes stay under it. Default: 65536.
# max_tool_output_chars = 65536

# Run a response's concurrency-safe tool calls at once instead of one
# at a time. Calls not safe to overlap still serialize (the engine's
# wave planner enforces it), so false only trades throughput for
# strictly one-at-a-time execution.
# One of: true (default), false.
# parallel_tool_dispatch = true

# Per-role prompt overrides. Repeatable; the entry whose role
# matches runner.role replaces that role's prompt whole.
# [[runner.role_overrides]]
# role = "coding"
# prompt = "…"

[project]
# Project-wide conventions injected into the agent's context.
# Default: unset.
# conventions = "…"

# Per-technology profiles. Repeatable.
# [[project.techs]]
# language = "rust"          # required
# build = "cargo build"      # optional
# test = "cargo test"        # optional
# lint = "cargo clippy"      # optional
# conventions = "…"          # optional

[telemetry]
# Log level, as the logging frontend understands it. One of:
# "trace", "debug", "info" (default), "warn", "error", "off".
# level = "info"

# Structured JSON logs instead of plain lines.
# One of: true, false (default).
# json_logs = false

[security]
# Redact secret-looking values from transcripts and tool previews.
# One of: true (default), false.
# redact_secrets = true

# External tool servers, launched and connected per session.
# [[mcp.servers]]
# name = "my-server"      # required
# command = "npx"         # required
# args = ["-y", "my-mcp"] # default: []
# env = { KEY = "value" } # default: empty
# tools = ["tool_a"]      # optional allow-list; unset exposes all
